<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ColdWarDemoTool</AssemblyName>
    <RootNamespace>ColdWarDemo.App</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ColdWarDemo.Core\ColdWarDemo.Core.csproj" />
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>
</Project>
